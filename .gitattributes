# Force LF line endings on checkout, including on Windows (Git for Windows defaults to CRLF):
# a CRLF shell script fails inside Linux containers ("bash\r: No such file or directory").
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.png binary
*.jpg binary
*.duckdb binary
*.parquet binary
