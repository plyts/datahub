# =============================================================================
# Data Hub — SECRETS (copy to .env with `make secrets`, never commit .env)
# `scripts/generate-secrets.sh` replaces every CHANGE_ME value with a strong random one.
# Non-secret settings live in envs/<env>.env.
# =============================================================================

# PostgreSQL (superuser + one role per service)
POSTGRES_PASSWORD=CHANGE_ME
DAGSTER_PG_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME
DATAHUB_APP_DB_PASSWORD=CHANGE_ME
DATAHUB_RO_PASSWORD=CHANGE_ME
GRAFANA_DB_PASSWORD=CHANGE_ME
POSTGRES_EXPORTER_PASSWORD=CHANGE_ME

# Keycloak master realm administrator (break-glass account)
KEYCLOAK_ADMIN_USERNAME=kcadmin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# First Data Hub administrator (realm "datahub", group /admins)
DATAHUB_ADMIN_USERNAME=datahub-admin
DATAHUB_ADMIN_EMAIL=admin@datahub.local
DATAHUB_ADMIN_PASSWORD=CHANGE_ME

# OIDC client secrets (substituted in the imported Keycloak realm)
OIDC_CLIENT_SECRET=CHANGE_ME
DAGSTER_PROXY_CLIENT_SECRET=CHANGE_ME
GRAFANA_OIDC_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME

# Cookie signing secrets
STREAMLIT_COOKIE_SECRET=CHANGE_ME
OAUTH2_PROXY_COOKIE_SECRET=CHANGE_ME_HEX32

# Grafana local administrator (break-glass account; users log in with Keycloak)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Demo users (dev / CI only — refused when DATAHUB_ENV=prod)
DEMO_USERS_PASSWORD=CHANGE_ME

# Notifications (optional)
NOTIFY_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=datahub@localhost
NOTIFY_EMAIL_TO=
