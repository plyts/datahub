# Data Hub — non-secret settings for the PROD environment (versioned in Git).
DATAHUB_ENV=prod
DATAHUB_VERSION=1.0.0
# Host name users type in their browser (DNS or /etc/hosts entry pointing to the VM).
DATAHUB_HOST=datahub.internal
DATAHUB_PUBLIC_URL=https://datahub.internal
# Caddy site address: http://... (LAN) or https://... (automatic TLS, internal CA for .local/.internal names)
DATAHUB_SITE_ADDRESS=https://datahub.internal
# TLS: auto = Let's Encrypt (public name) or Caddy internal CA (.internal); files = company PKI in certs/
DATAHUB_TLS_MODE=auto
DATAHUB_TLS_DIR=./certs
COOKIE_SECURE=true
DATAHUB_HTTP_PORT=80
DATAHUB_HTTPS_PORT=443
DATAHUB_AUTH_MODE=oidc
DATAHUB_TIMEZONE=Europe/Paris
DATAHUB_PARTITIONS_START=2026-01-01
KEYCLOAK_REALM=datahub
DBT_THREADS=6
PROMETHEUS_RETENTION=90d
