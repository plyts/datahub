# Data Hub — local test on Windows with Docker Desktop (WSL 2). Same as DEV, own compose override.
DATAHUB_ENV=dev
DATAHUB_VERSION=1.0.0
# Host name users type in their browser (DNS or /etc/hosts entry pointing to the VM).
DATAHUB_HOST=datahub.local
DATAHUB_PUBLIC_URL=http://datahub.local
# Caddy site address: http://... (LAN) or https://... (automatic TLS, internal CA for .local/.internal names)
DATAHUB_SITE_ADDRESS=http://datahub.local
COOKIE_SECURE=false
DATAHUB_HTTP_PORT=80
DATAHUB_HTTPS_PORT=443
DATAHUB_AUTH_MODE=oidc
DATAHUB_TIMEZONE=Europe/Paris
DATAHUB_PARTITIONS_START=2026-01-01
KEYCLOAK_REALM=datahub
DBT_THREADS=4
PROMETHEUS_RETENTION=7d
