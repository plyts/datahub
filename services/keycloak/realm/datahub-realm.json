{
  "realm": "${KEYCLOAK_REALM:datahub}",
  "displayName": "Data Hub",
  "displayNameHtml": "<b>Data Hub</b>",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "passwordPolicy": "length(12) and digits(1) and upperCase(1) and lowerCase(1) and notUsername(undefined) and passwordHistory(3)",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "fr",
    "en"
  ],
  "defaultLocale": "fr",
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "LOGOUT_ERROR",
    "CODE_TO_TOKEN",
    "CODE_TO_TOKEN_ERROR",
    "UPDATE_PASSWORD",
    "UPDATE_PASSWORD_ERROR",
    "CLIENT_LOGIN",
    "CLIENT_LOGIN_ERROR"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Administration complète",
        "composite": false
      },
      {
        "name": "DATA_ENGINEER",
        "description": "Création, modification et exécution des pipelines",
        "composite": false
      },
      {
        "name": "ANALYST",
        "description": "Consultation du catalogue, lineage et qualité",
        "composite": false
      },
      {
        "name": "VIEWER",
        "description": "Consultation des dashboards et historiques",
        "composite": false
      }
    ]
  },
  "groups": [
    {
      "name": "admins",
      "path": "/admins",
      "realmRoles": [
        "ADMIN"
      ]
    },
    {
      "name": "data-engineers",
      "path": "/data-engineers",
      "realmRoles": [
        "DATA_ENGINEER"
      ]
    },
    {
      "name": "analysts",
      "path": "/analysts",
      "realmRoles": [
        "ANALYST"
      ]
    },
    {
      "name": "viewers",
      "path": "/viewers",
      "realmRoles": [
        "VIEWER"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "datahub-ui",
      "name": "Data Hub (Streamlit)",
      "description": "Interface Data Hub — authentification via st.login()",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "${DATAHUB_PUBLIC_URL}",
      "baseUrl": "/",
      "redirectUris": [
        "${DATAHUB_PUBLIC_URL}/oauth2callback"
      ],
      "webOrigins": [
        "${DATAHUB_PUBLIC_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${DATAHUB_PUBLIC_URL}/*",
        "backchannel.logout.session.required": "true"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "basic",
        "profile",
        "email",
        "roles"
      ],
      "optionalClientScopes": [
        "offline_access"
      ],
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "dagster-proxy",
      "name": "Dagster UI (oauth2-proxy)",
      "description": "Protection de l'interface native Dagster et de la doc dbt",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${DAGSTER_PROXY_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "${DATAHUB_PUBLIC_URL}",
      "baseUrl": "/",
      "redirectUris": [
        "${DATAHUB_PUBLIC_URL}/oauth2/callback"
      ],
      "webOrigins": [
        "${DATAHUB_PUBLIC_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${DATAHUB_PUBLIC_URL}/*",
        "backchannel.logout.session.required": "true"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "basic",
        "profile",
        "email",
        "roles"
      ],
      "optionalClientScopes": [
        "offline_access"
      ],
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "dagster-proxy",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "grafana",
      "name": "Grafana",
      "description": "SSO Grafana — rôle Grafana dérivé des rôles Data Hub",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${GRAFANA_OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "${DATAHUB_PUBLIC_URL}",
      "baseUrl": "/",
      "redirectUris": [
        "${DATAHUB_PUBLIC_URL}/grafana/login/generic_oauth"
      ],
      "webOrigins": [
        "${DATAHUB_PUBLIC_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${DATAHUB_PUBLIC_URL}/*",
        "backchannel.logout.session.required": "true"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "basic",
        "profile",
        "email",
        "roles"
      ],
      "optionalClientScopes": [
        "offline_access"
      ],
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "datahub-admin-api",
      "name": "Data Hub — compte de service d'administration",
      "description": "Utilisé par les modules Administration et IAM (lecture/gestion des utilisateurs et rôles).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_ADMIN_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "basic",
        "roles",
        "service_account",
        "kc-admin-api"
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-datahub-admin-api",
      "enabled": true,
      "serviceAccountClientId": "datahub-admin-api",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "manage-users",
          "query-users",
          "query-groups",
          "view-clients",
          "query-clients",
          "view-realm"
        ]
      }
    },
    {
      "username": "${DATAHUB_ADMIN_USERNAME:datahub-admin}",
      "enabled": true,
      "emailVerified": true,
      "email": "${DATAHUB_ADMIN_EMAIL:admin@datahub.local}",
      "firstName": "Data Hub",
      "lastName": "Administrateur",
      "credentials": [
        {
          "type": "password",
          "value": "${DATAHUB_ADMIN_PASSWORD}",
          "temporary": false
        }
      ],
      "groups": [
        "/admins"
      ]
    }
  ]
}